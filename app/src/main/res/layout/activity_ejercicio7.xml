<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".Ejercicio7Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 7: CRUD Local (json-server)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Endpoint: http://10.0.2.2:3000/usuarios"
            android:textSize="12sp"
            android:gravity="center"
            android:textColor="#666666"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnGetLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GET - Obtener Usuarios"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPostLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POST - Crear Usuario Aleatorio"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPutLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PUT - Actualizar Usuario (id=1)"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPatchLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PATCH - Actualizar Edad (id=2)"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnDeleteLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DELETE - Eliminar Usuario (id=1)"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSalidaLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Presiona cualquier botón para interactuar con json-server..."
            android:textSize="14sp"
            android:textColor="#000000"
            android:background="#F5F5F5"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
