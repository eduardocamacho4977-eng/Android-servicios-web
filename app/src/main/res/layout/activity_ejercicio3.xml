<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".Ejercicio3Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 3: PUT vs PATCH"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnPut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actualizar Todo (PUT)"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modificar Título (PATCH)"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvResultadoPutPatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Presiona un botón para enviar la petición..."
            android:textSize="15sp"
            android:textColor="#333333"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
